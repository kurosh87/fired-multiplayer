{
	admin off
	persist_config off
	email {$KANTO_ACME_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://:8080 {
	redir https://{$KANTO_API_DOMAIN}{uri} 308
}

https://{$KANTO_API_DOMAIN}:8443 {
	reverse_proxy api:8787 {
		transport http {
			dial_timeout 5s
			response_header_timeout 10s
		}
	}
}
