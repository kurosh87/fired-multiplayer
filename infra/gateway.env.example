# Example only. Copy outside the checkout; do not put credentials in Git.
# Node --env-file syntax; the JSON value is one quoted line.
HOST=127.0.0.1
GATEWAY_PORT=8788
WEB_ORIGIN=http://127.0.0.1:5173
WORKER_NODES_JSON='[{"id":"alpha","origin":"http://127.0.0.1:8791"},{"id":"bravo","origin":"http://127.0.0.1:8792"}]'
SUPABASE_URL=https://YOUR_DEDICATED_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Only the immediate HTTPS ingress addresses, if present. Empty trusts none.
TRUST_PROXY_CIDRS=
