# Add these non-secret settings to the single-API operator env file.
# Use one exact approved DNS hostname, without scheme, path, port or wildcard.
KANTO_API_DOMAIN=api.your-approved-domain.example
KANTO_ACME_EMAIL=your-approved-operator@example.com
KANTO_CADDYFILE=/etc/kanto/Caddyfile.staging
# Pre-create on the Linux host, owned by UID/GID 1000, mode 0700. Retain it.
KANTO_TLS_DIRECTORY=/srv/kanto/tls
# Choose an unused subnet and an ingress address inside it; change together.
KANTO_INGRESS_SUBNET=172.30.45.0/28
KANTO_INGRESS_PRIVATE_IP=172.30.45.2
