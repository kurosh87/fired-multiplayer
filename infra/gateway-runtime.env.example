# Gateway Auth settings only; outside checkout, mode 0600, Compose raw format.
# Use the same dedicated account provider as the APIs. Do not include the game
# DATABASE_URL. Better Auth uses a separate account connection as described below.
SUPABASE_URL=https://YOUR_DEDICATED_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Better Auth alternative: clear both SUPABASE fields above and configure all
# three below. This account login must not inherit the game-data role.
ACCOUNT_ORIGIN=
ACCOUNT_DATABASE_URL=
BETTER_AUTH_SECRET=
