# Standalone compose.gateway.staging.yml operator settings, outside checkout.
KANTO_API_IMAGE=kanto-api-staging:REPLACE_WITH_SOURCE_HASH
KANTO_RUNTIME_ENV_FILE=/etc/kanto/staging-runtime.env
KANTO_GATEWAY_RUNTIME_ENV_FILE=/etc/kanto/gateway-runtime.env
KANTO_ENGINE_DIRECTORY=/srv/kanto/artifacts
KANTO_WEB_ORIGIN=https://your-staging-client.example
# Reserve an unused private subnet. The fixed gateway address must be in it.
KANTO_WORKER_SUBNET=172.30.44.0/28
KANTO_GATEWAY_PRIVATE_IP=172.30.44.2
