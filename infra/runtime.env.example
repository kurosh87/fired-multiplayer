# Private API-only configuration; create outside the checkout with mode 0600.
# Compose raw format: use literal values without enclosing quotes.
# Use a dedicated Kanto project and restricted game-server database login.
SUPABASE_URL=https://YOUR_DEDICATED_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
DATABASE_URL=REPLACE_WITH_RESTRICTED_TRANSACTION_POOLER_URL
# Better Auth alternative: clear both SUPABASE fields above and configure all
# three below. Use only the dedicated Kanto account database and auth secret.
ACCOUNT_ORIGIN=
ACCOUNT_DATABASE_URL=
BETTER_AUTH_SECRET=
