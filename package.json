{
  "name": "kanto-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @kanto/web",
    "dev:server": "npm run dev -w @kanto/server",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:web": "playwright test",
    "test:engine-browser": "playwright test --config playwright.engine.config.ts",
    "test:engine-preview": "playwright test --config playwright.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build -w @kanto/web",
    "build:preview": "node --experimental-strip-types scripts/build-preview.ts",
    "preflight": "node scripts/preflight.mjs",
    "install:guarded": "node scripts/install.mjs",
    "engine:fetch": "python3 scripts/fetch-upstream.py",
    "engine:audit": "python3 scripts/audit-port.py",
    "engine:verify": "node --experimental-strip-types scripts/verify-engine.ts",
    "engine:benchmark": "node --experimental-strip-types scripts/benchmark-engine.ts",
    "engine:benchmark-gameplay": "node --experimental-strip-types scripts/benchmark-gameplay.ts",
    "engine:preview": "node --experimental-strip-types scripts/preview-engine.ts",
    "db:check": "node --experimental-strip-types --test tests/postgres.integration.test.ts",
    "db:check-local": "python3 -B scripts/check-database.py",
    "engine:benchmark-mixed": "python3 -B scripts/check-database.py --mixed",
    "engine:prepare": "python3 scripts/prepare-engine.py",
    "engine:test-platform": "python3 scripts/check-platform.py",
    "engine:test-data": "python3 -B scripts/check-data-conversion.py",
    "engine:test-scheduler": "python3 -B scripts/check-scheduler.py",
    "engine:test-reset-memory": "python3 -B scripts/check-reset-memory.py",
    "engine:test-record-layout": "python3 -B scripts/check-record-layout.py",
    "engine:compile-source": "python3 -B scripts/compile-game.py",
    "engine:build-data": "python3 -B scripts/build-game-data.py",
    "engine:link-candidate": "python3 -B scripts/link-candidate.py",
    "engine:check-candidate": "node --experimental-strip-types scripts/check-candidate.ts",
    "engine:baseline": "python3 -B scripts/build-baseline.py",
    "engine:reference": "python3 -B scripts/run-reference.py",
    "engine:compare-reference": "node --experimental-strip-types scripts/compare-reference.ts",
    "engine:check-gameplay": "node --experimental-strip-types scripts/check-gameplay.ts",
    "engine:check-extended-adventure": "node --experimental-strip-types scripts/check-extended-adventure.ts",
    "engine:check-storage": "node --experimental-strip-types scripts/check-storage-adventure.ts",
    "engine:check-storage-readback": "node --experimental-strip-types scripts/check-storage-readback.ts",
    "engine:finalize-storage": "node --experimental-strip-types scripts/finalize-storage-evidence.ts",
    "engine:check-audio": "node --experimental-strip-types scripts/check-audio-candidate.ts",
    "test:audio-browser": "playwright test --config playwright.audio.config.ts",
    "engine:check-memory": "node --experimental-strip-types scripts/check-memory-candidate.ts",
    "engine:check-entropy": "node --experimental-strip-types scripts/check-entropy.ts",
    "engine:check-exchange": "node --experimental-strip-types scripts/check-exchange.ts",
    "engine:check-lobby": "node --experimental-strip-types scripts/check-lobby.ts",
    "engine:check-trade-bindings": "node --experimental-strip-types scripts/check-trade-bindings.ts",
    "engine:build-battle": "python3 -B scripts/build-battle-candidate.py",
    "engine:check-battle": "node --experimental-strip-types scripts/check-battle.ts",
    "engine:check-battle-workers": "node --experimental-strip-types scripts/check-battle-workers.ts",
    "engine:benchmark-battles": "node --experimental-strip-types scripts/benchmark-battles.ts",
    "test:battle-browser": "playwright test --config playwright.battle.config.ts",
    "engine:check-lobby-readback": "node --experimental-strip-types scripts/check-lobby-readback.ts",
    "engine:check-exchange-readback": "node --experimental-strip-types scripts/check-exchange-readback.ts",
    "engine:check-save-readback": "node --experimental-strip-types scripts/check-save-readback.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.2",
    "@netlify/identity": "2.0.0",
    "better-auth": "1.7.10",
    "kysely": "0.29.6"
  }
}
