# Browser (publishable configuration only)
VITE_API_URL=http://127.0.0.1:8787
# HTTP is under private qualification and requires the same-origin handler
# and fifth migration. The public site does not enable multiplayer yet.
VITE_BATTLE_TRANSPORT=socket
# Use better-auth for Kanto's same-origin /api/cloud account service, or
# supabase for the legacy local prototype. No private values belong in VITE_*.
VITE_ACCOUNT_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
# Comma-separated ingress IPs/CIDRs only; blank ignores forwarded headers.
TRUST_PROXY_CIDRS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Persistent Better Auth alternative. Leave both Supabase server fields blank
# when using these. ACCOUNT_DATABASE_URL belongs to Kanto's account database;
# use its restricted runtime login and the existing Kanto-only auth secret.
ACCOUNT_ORIGIN=
ACCOUNT_DATABASE_URL=
BETTER_AUTH_SECRET=
# Use Supabase's transaction pooler connection string with a restricted server role.
DATABASE_URL=
ENGINE_DIRECTORY=./engine/artifacts
# Separate server-only battle artifacts; defaults to ENGINE_DIRECTORY/battle.
BATTLE_ENGINE_DIRECTORY=
# Bounded worker threads per API process (1–32); default min(4, CPU count - 2).
BATTLE_WORKERS=4
# Bounded authoritative adventure workers per API process (1–32).
ADVENTURE_WORKERS=4
TRADE_WORKERS=4
INSPECTION_WORKERS=4
# thread (local default) or process (separate private worker processes).
# Process mode still requires host/container RSS limits for public deployment.
GAME_WORKER_TRANSPORT=thread
# A public server refuses experimental artifacts.
PUBLIC_RELEASE=false
